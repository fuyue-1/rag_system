# ============================================================
# 智蜂专家 RAG 系统 - Git 忽略规则
# ============================================================

# ===== 密钥与本地配置（绝不提交到仓库）=====
# .env 含 DeepSeek / LangSmith 等明文密钥，泄露会被盗刷
.env*
!.env.example

# ===== 个人材料 / 临时产物（不上传）=====
# 面试与答辩的个人准备材料，按需自行决定是否公开
面试问答.md
面试稿*.md
certs/
.tmp_*
*.bak
~$*

# ===== 模型与大文件（首次运行自动下载 / 从 MySQL 重建）=====
# models/ 含 fastembed 本地向量模型（数百 MB）与下载缓存
models/
# vector_db/ 为 Chroma 持久化向量库，启动时可从 MySQL 自动重建
vector_db/

# ===== Python 缓存 / 虚拟环境 =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== 工具与编辑缓存 =====
.shot_tool/
.cache/
.slidep/

# ===== 系统与编辑器杂项 =====
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# ===== 与本仓库无关的旧项目（曾出现在对话工作区）=====
maze-rank-fix/

# ===== 运行时生成目录 / 二进制文档（不提交）=====
uploads/
*.docx
*.doc
*.pptx
*.ppt
