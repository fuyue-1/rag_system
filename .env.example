# ============================================================
# 智蜂专家 RAG 系统 - 环境配置样例
# ------------------------------------------------------------
# 用法：把本文件复制为同目录下的 .env，再填入你自己的值。
# 注意：.env 含有真实密钥，已被 .gitignore 忽略，切勿提交到公开仓库。
# ============================================================

# ===== LLM 生成（DeepSeek 等 OpenAI 兼容接口）=====
# 去 https://platform.deepseek.com 注册获取；也可换成任意 OpenAI 兼容 endpoint
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat

# ===== 语义向量化（Embedding）=====
# provider=local  → 本地离线 bge-small-zh（fastembed ONNX，512维），无需任何密钥，首次运行自动下载
# provider=api    → 硅基流动 bge-m3（1024维），需在下方填 EMBEDDING_API_KEY
EMBEDDING_PROVIDER=local
# 仅 provider=api 时需要：https://cloud.siliconflow.cn
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 用户登录鉴权 =====
# true=启用（问答/知识库需登录）；false=关闭（免登录，适合本地演示）
AUTH_ENABLED=true
# 会话签名密钥：改成任意随机字符串
SECRET_KEY=please-change-me-to-a-random-string

# ===== 今日天气（顶栏显示温度/湿度，数据源 Open-Meteo 免费无需key）=====
WEATHER_LAT=39.9042
WEATHER_LON=116.4074
WEATHER_LOCATION=北京

# ===== MySQL（本地开发默认值即可；部署到服务器时按实际情况修改）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=bee_rag

# ===== LangSmith 评测（可选，仅运行 evaluate_*.py 时需要）=====
# 获取地址：LangSmith 左下角 Settings -> API Keys
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
